{
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Blur"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Sirf blur - video, title, description, comments alag alag blur karo, Focus Mode ke saath. Download hata diya gaya hai.",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "manifest_version": 3,
  "name": "YouTube Blur - Hover to Reveal",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "version": "2.0.0"
}